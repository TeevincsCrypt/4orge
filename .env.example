# 4ORGE configuration. Copy to .env.local and fill in only what you need.
# Every variable is optional: with none set, 4ORGE runs in single-user LOCAL MODE
# (data in ./.forge-data, only reachable from this computer).
# Never commit .env.local. Never put wallet private keys or seed phrases anywhere.

# --- Supabase (multi-user cloud mode) --------------------------------------
# Project Settings → API. The anon key is public by design; RLS protects data.
# Apply supabase/migrations/*.sql to your project before enabling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this deployment (used for OAuth redirects), e.g. https://forge.example.com
NEXT_PUBLIC_APP_URL=

# --- GitHub OAuth (import private repositories) -----------------------------
# Create an OAuth App: callback URL = <your URL>/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random string of at least 32 characters (encrypts the GitHub token cookie).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORGE_SESSION_SECRET=

# --- Execution & safety ------------------------------------------------------
# Test runner: all | solidity | disabled  (default: all in local mode, solidity with Supabase)
FORGE_TEST_RUNNER=
# Max concurrent compiler/test processes (default 2)
FORGE_MAX_JOBS=
# Show the Local Hardhat network (chain 31337) for rehearsals with `npm run chain`
FORGE_ENABLE_LOCAL_CHAIN=false
# Mainnet deployments are LOCKED unless this is deliberately set to true.
FORGE_ENABLE_MAINNET_DEPLOYMENTS=false

# Optional: QIE ID (name.qie) resolver. Defaults to QIE's official QIE Wallet MCP server.
# FORGE_QIE_ID_RESOLVER_URL=https://mcp.qie.digital/mcp
# Allow non-localhost access in local mode (no authentication!). Leave false.
FORGE_ALLOW_REMOTE_LOCAL_MODE=false

# --- Storage paths (optional) -------------------------------------------------
FORGE_DATA_DIR=.forge-data
FORGE_CACHE_DIR=.forge-cache
